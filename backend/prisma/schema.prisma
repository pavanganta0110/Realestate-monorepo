// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SALES_ADMIN
  TENANT_ADMIN
  AGENT
  TENANT
}

enum AgentAccountStatus {
  PENDING
  APPROVED
  DECLINED
  SUSPENDED
}

enum AnnouncementAudience {
  TENANT
  AGENT
}

enum PropertyOwnerPayoutStatus {
  PENDING_ONBOARDING
  ACTIVE
  RESTRICTED
  DISABLED
}

enum ListingType {
  SALE
  RENT
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum InquiryStatus {
  OPEN
  CLOSED
}

enum InquirySenderType {
  BUYER
  AGENT
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

enum WebsiteLeadStatus {
  NEW
  CONTACTED
  SCREENING
  TOUR_SCHEDULED
  CLOSED
}

enum WebsiteLeadScreeningStatus {
  NOT_STARTED
  IN_PROGRESS
  QUALIFIED
  NOT_QUALIFIED
}

enum WebsiteLeadTourStatus {
  NOT_SCHEDULED
  SCHEDULED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum WebsiteLeadSource {
  CHATBOT
  CONTACT_FORM
}

enum WebsiteLeadIntent {
  GENERAL
  RENTAL_INQUIRY
  RENTAL_TOUR
  RENTAL_APPLICATION
  SIMILAR_RENTAL
  BUYER_INQUIRY
  SELLER_INQUIRY
  MARKET_REPORT
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum RentalApplicationStatus {
  DRAFT
  FEE_PENDING
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  APPROVED
  DENIED
  WITHDRAWN
}

enum RentalApplicationFeeStatus {
  NOT_REQUIRED
  PENDING
  OPEN
  PAID
  FAILED
  EXPIRED
  REFUNDED
  DISPUTED
}

enum RentalApplicationDocumentType {
  GOVERNMENT_ID
  INCOME_PROOF
  OTHER
}

enum RentalApplicationDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum RentalApplicationHandoffStatus {
  STARTED
  TENANT_INVITED
  LEASE_CREATED
  ENVELOPE_CREATING
  ENVELOPE_SENT
  SIGNED
  ACTION_REQUIRED
  FAILED
}

enum PaymentPurpose {
  RENT
  MOVE_IN
}

enum OwnerExpenseCategory {
  MAINTENANCE
}

enum OwnerExpenseEntryType {
  CHARGE
  ADJUSTMENT
}

enum MoveInChargeCategory {
  FIRST_MONTH_RENT
  SECURITY_DEPOSIT
  PET_FEE
  UTILITY
  MOVE_IN_FEE
  OTHER
}

enum MoveInChargePayoutTreatment {
  OWNER_NET_OF_COMMISSION
  OWNER_FULL
  JOHNSON_REALTY
}

enum MoveInChargeStatus {
  OPEN
  PARTIAL
  PAID
  WAIVED
  VOID
}

enum MoveInChargeSource {
  LEASE_ACTIVATION
  MANUAL
}

enum MoveInInspectionStatus {
  DRAFT
  READY_FOR_TENANT
  COMPLETED
  CANCELED
}

enum LeaseRenewalStatus {
  DRAFT
  SIGNING
  SIGNED
  DECLINED
  CANCELED
  EXPIRED
  FAILED
}

enum NoticeToVacateSource {
  TENANT
  MANAGEMENT
  MUTUAL
}

enum NoticeToVacateStatus {
  SUBMITTED
  ACKNOWLEDGED
  MOVE_OUT_IN_PROGRESS
  COMPLETED
  CANCELED
}

enum MoveOutInspectionStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  TENANT_ACKNOWLEDGED
  CANCELED
}

enum MoveOutTurnoverStatus {
  READY_TO_RENT
  MAINTENANCE_REQUIRED
}

enum SecurityDepositDispositionStatus {
  DRAFT
  ITEMIZED
  ISSUED
  RETURNED
  DISPUTED
}

enum SecurityDepositDeductionCategory {
  CLEANING
  DAMAGE
  UNPAID_RENT
  LATE_FEES
  UTILITIES
  KEY_REPLACEMENT
  OTHER
}

enum SecurityDepositLedgerEntryType {
  OPENING_BALANCE
  DEDUCTION
  REFUND
  ADJUSTMENT
}

enum SecurityDepositReturnMethod {
  CHECK
  ACH
  CASH
  OTHER
}

enum InspectionCondition {
  NOT_INSPECTED
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
  NOT_APPLICABLE
}

enum InspectionPhotoSource {
  STAFF
  TENANT
}

enum InspectionMeterType {
  ELECTRIC
  GAS
  WATER
  OTHER
}

enum InspectionKeyType {
  UNIT
  MAILBOX
  GARAGE
  FOB
  ACCESS_CARD
  OTHER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum CommissionPaymentMethod {
  ACH
  CASH
  CHECK
  WIRE
  OTHER
}

enum SaleCommissionStatus {
  ACTIVE
  VOIDED
}

enum SaleCommissionEventType {
  CREATED
  CORRECTED
  VOIDED
}

enum ESignatureProvider {
  VERDOCS
}

enum ESignatureDocumentType {
  LEASE
  DISCLOSURE
  AGREEMENT
}

enum ESignatureTargetType {
  TENANT
  AGENT
}

enum ESignatureEnvelopeStatus {
  CREATING
  PENDING
  IN_PROGRESS
  FINALIZING
  COMPLETED
  DECLINED
  CANCELED
  EXPIRED
  FAILED
}

enum ESignatureEventSource {
  LOCAL
  VERDOCS
}

enum ESignatureStoredDocumentType {
  SIGNED_DOCUMENT
  CERTIFICATE
}

model User {
  id                           String                            @id @default(cuid())
  authUserId                   String                            @unique @db.Uuid
  email                        String                            @unique
  role                         Role                              @default(TENANT)
  status                       UserStatus                        @default(INVITED)
  failedLoginAttempts          Int                               @default(0)
  lastFailedLoginAt            DateTime?
  lockedUntil                  DateTime?
  createdAt                    DateTime                          @default(now())
  updatedAt                    DateTime                          @updatedAt
  tenantProfile                Tenant?
  agentProfile                 Agent?                            @relation("AgentUser")
  approvedAgents               Agent[]                           @relation("AgentApprovedBy")
  reviewedProperties           Property[]                        @relation("PropertyReviewedBy")
  sentMessages                 Message[]                         @relation("SentMessages")
  receivedMessages             Message[]                         @relation("ReceivedMessages")
  auditLogs                    AuditLog[]
  notifications                Notification[]
  uploadedTenantDocuments      Document[]                        @relation("TenantDocumentUploadedBy")
  announcementAcknowledgements AnnouncementAcknowledgement[]
  recordedCommissions          SaleCommission[]                  @relation("SaleCommissionRecordedBy")
  voidedCommissions            SaleCommission[]                  @relation("SaleCommissionVoidedBy")
  commissionEvents             SaleCommissionEvent[]             @relation("SaleCommissionEventActor")
  createdESignatures           ESignatureEnvelope[]              @relation("ESignatureCreatedBy")
  assignedWebsiteLeads         WebsiteLead[]                     @relation("WebsiteLeadAssignedTo")
  websiteLeadNotes             WebsiteLeadNote[]                 @relation("WebsiteLeadNoteAuthor")
  assignedRentalApplications   RentalApplication[]               @relation("RentalApplicationAssignedTo")
  rentalApplicationNotes       RentalApplicationNote[]           @relation("RentalApplicationNoteAuthor")
  reviewedRentalDocuments      RentalApplicationDocument[]       @relation("RentalApplicationDocumentReviewedBy")
  initiatedRentalHandoffs      RentalApplicationHandoff[]        @relation("RentalApplicationHandoffInitiatedBy")
  postedMoveInCharges          MoveInCharge[]                    @relation("MoveInChargePostedBy")
  adjustedMoveInCharges        MoveInCharge[]                    @relation("MoveInChargeAdjustedBy")
  preparedMoveInInspections    MoveInInspection[]                @relation("MoveInInspectionPreparedBy")
  moveInInspectionPhotos       MoveInInspectionPhoto[]           @relation("MoveInInspectionPhotoUploadedBy")
  moveInAcknowledgements       MoveInInspectionAcknowledgement[] @relation("MoveInInspectionAcknowledgedBy")
  postedOwnerExpenses          OwnerExpenseLedgerEntry[]         @relation("OwnerExpensePostedBy")
  createdLeaseRenewals         LeaseRenewal[]                    @relation("LeaseRenewalCreatedBy")
  createdVacateNotices         NoticeToVacate[]                  @relation("VacateNoticeCreatedBy")
  acknowledgedVacateNotices    NoticeToVacate[]                  @relation("VacateNoticeAcknowledgedBy")
  preparedMoveOutInspections   MoveOutInspection[]               @relation("MoveOutInspectionPreparedBy")
  createdDepositDispositions   SecurityDepositDisposition[]      @relation("DepositDispositionCreatedBy")
  postedDepositLedgerEntries   SecurityDepositLedgerEntry[]      @relation("DepositLedgerPostedBy")
  sentEmailLogs                EmailLog[]                        @relation("EmailLogSender")
  createdEmailBatches          EmailBatch[]                      @relation("EmailBatchCreator")
}

model Agent {
  id                       String               @id @default(cuid())
  userId                   String               @unique
  user                     User                 @relation("AgentUser", fields: [userId], references: [id])
  companyName              String
  contactName              String
  email                    String               @unique
  phone                    String?
  accountStatus            AgentAccountStatus   @default(PENDING)
  stripeConnectedAccountId String?              @unique
  verificationDocuments    String[]
  approvedAt               DateTime?
  approvedByUserId         String?
  approvedBy               User?                @relation("AgentApprovedBy", fields: [approvedByUserId], references: [id])
  declineReason            String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  properties               Property[]
  listingInquiries         ListingInquiry[]
  saleCommissions          SaleCommission[]
  eSignatureEnvelopes      ESignatureEnvelope[]

  @@index([accountStatus])
  @@index([approvedByUserId])
}

model PropertyOwner {
  id                        String                            @id @default(cuid())
  ownerName                 String?
  companyName               String?
  contactEmail              String
  contactPhone              String?
  stripeConnectedAccountId  String?                           @unique
  payoutStatus              PropertyOwnerPayoutStatus         @default(PENDING_ONBOARDING)
  commissionRate            Decimal                           @default(10.00) @db.Decimal(5, 2)
  stripeAccountLastSyncedAt DateTime?
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
  onboardedAt               DateTime?
  properties                Property[]
  payments                  Payment[]
  moveInCharges             MoveInCharge[]
  moveInInspections         MoveInInspection[]
  moveInAcknowledgements    MoveInInspectionAcknowledgement[]
  expenseLedgerEntries      OwnerExpenseLedgerEntry[]

  @@index([payoutStatus])
}

model Property {
  id                   String                    @id @default(cuid())
  listingType          ListingType               @default(RENT)
  listingStatus        ListingStatus?
  publishStatus        PublishStatus             @default(DRAFT)
  ownerId              String?
  owner                PropertyOwner?            @relation(fields: [ownerId], references: [id])
  agentId              String?
  agent                Agent?                    @relation(fields: [agentId], references: [id])
  reviewedByUserId     String?
  reviewedBy           User?                     @relation("PropertyReviewedBy", fields: [reviewedByUserId], references: [id])
  name                 String
  address              String
  city                 String
  state                String
  zip                  String
  propertyType         String // single family, duplex, apartment, commercial
  description          String?
  price                Decimal?                  @db.Decimal(12, 2)
  rentAmount           Decimal?                  @db.Decimal(12, 2)
  applicationFeeAmount Decimal                   @default(0) @db.Decimal(12, 2)
  bedrooms             Int?
  bathrooms            Float?
  squareFeet           Int?
  availabilityDate     DateTime?
  amenities            String[]
  utilityInfo          String?
  photos               String[]
  documents            String[]
  status               String                    @default("active")
  submittedAt          DateTime?
  reviewedAt           DateTime?
  rejectionReason      String?
  publishedAt          DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  units                Unit[]
  maintenanceRequests  MaintenanceRequest[]
  announcements        Announcement[]
  listingInquiries     ListingInquiry[]
  websiteLeads         WebsiteLead[]
  saleCommissions      SaleCommission[]
  eSignatureEnvelopes  ESignatureEnvelope[]
  rentalApplications   RentalApplication[]
  expenseLedgerEntries OwnerExpenseLedgerEntry[]
  emailLogs           EmailLog[]
  emailBatches        EmailBatch[]

  @@index([ownerId])
  @@index([agentId])
  @@index([reviewedByUserId])
  @@index([listingType, listingStatus])
  @@index([listingType, publishStatus, updatedAt(sort: Desc), id(sort: Desc)])
}

model ListingInquiry {
  id                        String                  @id @default(cuid())
  propertyId                String
  property                  Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agentId                   String
  agent                     Agent                   @relation(fields: [agentId], references: [id])
  buyerName                 String
  buyerEmail                String
  buyerPhone                String?
  buyerAccessTokenHash      String                  @unique
  buyerAccessTokenExpiresAt DateTime
  status                    InquiryStatus           @default(OPEN)
  agentLastReadAt           DateTime?
  lastMessageAt             DateTime                @default(now())
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  messages                  ListingInquiryMessage[]

  @@index([agentId, status, lastMessageAt])
  @@index([agentId, lastMessageAt(sort: Desc)])
  @@index([lastMessageAt(sort: Desc)])
  @@index([propertyId, lastMessageAt])
}

model ListingInquiryMessage {
  id         String            @id @default(cuid())
  inquiryId  String
  inquiry    ListingInquiry    @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  senderType InquirySenderType
  body       String
  readAt     DateTime?
  createdAt  DateTime          @default(now())

  @@index([inquiryId, createdAt])
}

model ChatConversation {
  id              String        @id @default(cuid())
  accessTokenHash String        @unique @db.Char(64)
  lastMessageAt   DateTime      @default(now())
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  messages        ChatMessage[]
  websiteLeads    WebsiteLead[]

  @@index([expiresAt])
  @@index([lastMessageAt(sort: Desc), id(sort: Desc)])
}

model WebsiteLead {
  id                   String                     @id @default(cuid())
  name                 String?
  email                String
  phone                String?
  message              String
  source               WebsiteLeadSource          @default(CHATBOT)
  intent               WebsiteLeadIntent?
  status               WebsiteLeadStatus          @default(NEW)
  propertyId           String?
  property             Property?                  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unitId               String?
  unit                 Unit?                      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  moveInDate           DateTime?                  @db.Date
  assignedToUserId     String?
  assignedTo           User?                      @relation("WebsiteLeadAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedAt           DateTime?
  contactedAt          DateTime?
  closedAt             DateTime?
  screeningStatus      WebsiteLeadScreeningStatus @default(NOT_STARTED)
  screeningSummary     String?
  screeningCompletedAt DateTime?
  tourStatus           WebsiteLeadTourStatus      @default(NOT_SCHEDULED)
  tourScheduledAt      DateTime?
  tourCompletedAt      DateTime?
  conversationId       String?
  conversation         ChatConversation?          @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  visitorDayHash       String?                    @db.Char(64)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  notes                WebsiteLeadNote[]
  rentalApplication    RentalApplication?

  @@index([status, createdAt(sort: Desc)])
  @@index([email])
  @@index([conversationId])
  @@index([propertyId, createdAt(sort: Desc)])
  @@index([unitId, createdAt(sort: Desc)])
  @@index([assignedToUserId, status, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([screeningStatus, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([tourStatus, tourScheduledAt])
}

model WebsiteLeadNote {
  id           String      @id @default(cuid())
  leadId       String
  lead         WebsiteLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User        @relation("WebsiteLeadNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  body         String
  createdAt    DateTime    @default(now())

  @@index([leadId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorUserId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatMessageRole
  content        String
  visitorDayHash String?          @db.Char(64)
  model          String?
  finishReason   String?
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([visitorDayHash, createdAt])
  @@index([role, createdAt])
}

model Unit {
  id                         String                       @id @default(cuid())
  propertyId                 String
  property                   Property                     @relation(fields: [propertyId], references: [id])
  unitNumber                 String
  floor                      String?
  bedrooms                   Int?
  bathrooms                  Float?
  squareFeet                 Int?
  rentAmount                 Float?
  depositAmount              Float?
  status                     String                       @default("vacant") // vacant, occupied, under maintenance, off market
  availableDate              DateTime?
  amenities                  String[]                     @default([])
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  tenants                    Tenant[]
  leases                     Lease[]
  payments                   Payment[]
  moveInCharges              MoveInCharge[]
  moveInInspections          MoveInInspection[]
  maintenanceRequests        MaintenanceRequest[]
  announcements              Announcement[]
  websiteLeads               WebsiteLead[]
  rentalApplications         RentalApplication[]
  expenseLedgerEntries       OwnerExpenseLedgerEntry[]
  NoticeToVacate             NoticeToVacate[]
  MoveOutInspection          MoveOutInspection[]
  SecurityDepositDisposition SecurityDepositDisposition[]
  SecurityDepositLedgerEntry SecurityDepositLedgerEntry[]
  emailLogs                  EmailLog[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId, status])
}

model RentalApplication {
  id                       String                        @id @default(cuid())
  propertyId               String
  property                 Property                      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unitId                   String?
  unit                     Unit?                         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  websiteLeadId            String?                       @unique
  websiteLead              WebsiteLead?                  @relation(fields: [websiteLeadId], references: [id], onDelete: SetNull)
  applicantAccessTokenHash String                        @unique @db.Char(64)
  applicantAccessExpiresAt DateTime
  firstName                String
  lastName                 String
  email                    String
  phone                    String
  dateOfBirth              DateTime                      @db.Date
  currentAddress           String
  currentCity              String
  currentState             String
  currentZip               String
  moveInDate               DateTime                      @db.Date
  householdSize            Int
  occupantsDescription     String?
  petsDescription          String?
  employmentStatus         String
  employerName             String?
  monthlyGrossIncome       Decimal                       @db.Decimal(12, 2)
  additionalIncome         Decimal                       @default(0) @db.Decimal(12, 2)
  rentalHistory            String?
  priorLandlordName        String?
  priorLandlordEmail       String?
  priorLandlordPhone       String?
  status                   RentalApplicationStatus       @default(DRAFT)
  feeStatus                RentalApplicationFeeStatus    @default(NOT_REQUIRED)
  feeAmount                Decimal                       @default(0) @db.Decimal(12, 2)
  feeCheckoutRequestId     String?                       @unique @db.Uuid
  stripeCheckoutSessionId  String?                       @unique
  stripeCheckoutUrl        String?                       @db.Text
  stripeCheckoutExpiresAt  DateTime?
  stripePaymentIntentId    String?                       @unique
  stripeChargeId           String?                       @unique
  feePaidAt                DateTime?
  assignedToUserId         String?
  assignedTo               User?                         @relation("RentalApplicationAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedAt               DateTime?
  reviewedAt               DateTime?
  decisionReason           String?
  consentVersion           String
  certifiedAt              DateTime?
  submittedAt              DateTime?
  decidedAt                DateTime?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  documents                RentalApplicationDocument[]
  notes                    RentalApplicationNote[]
  stripeWebhookEvents      StripeWebhookEvent[]
  accessLinks              RentalApplicationAccessLink[]
  lease                    Lease?
  handoff                  RentalApplicationHandoff?

  @@index([status, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([assignedToUserId, status, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([propertyId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([email, createdAt(sort: Desc)])
  @@index([feeStatus, updatedAt(sort: Desc), id(sort: Desc)])
}

model RentalApplicationAccessLink {
  id            String            @id @default(cuid())
  applicationId String
  application   RentalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tokenHash     String            @unique @db.Char(64)
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime          @default(now())

  @@index([applicationId, expiresAt(sort: Desc), id(sort: Desc)])
  @@index([expiresAt])
}

model RentalApplicationDocument {
  id               String                          @id @default(cuid())
  applicationId    String
  application      RentalApplication               @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type             RentalApplicationDocumentType
  status           RentalApplicationDocumentStatus @default(PENDING)
  storagePath      String                          @unique
  originalFileName String
  contentType      String
  sizeBytes        Int
  reviewedByUserId String?
  reviewedBy       User?                           @relation("RentalApplicationDocumentReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  @@index([applicationId, type, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([reviewedByUserId])
}

model RentalApplicationNote {
  id            String            @id @default(cuid())
  applicationId String
  application   RentalApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorUserId  String
  author        User              @relation("RentalApplicationNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  body          String
  createdAt     DateTime          @default(now())

  @@index([applicationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorUserId])
}

model Tenant {
  id                              String                            @id @default(cuid())
  firstName                       String
  lastName                        String
  email                           String                            @unique
  phone                           String?
  dateOfBirth                     DateTime?
  emergencyContactName            String?
  emergencyContactPhone           String?
  vehicleInfo                     String?
  petInfo                         String?
  status                          String                            @default("invited")
  lastMessageAt                   DateTime?
  userId                          String?                           @unique
  user                            User?                             @relation(fields: [userId], references: [id])
  unitId                          String?
  unit                            Unit?                             @relation(fields: [unitId], references: [id])
  createdAt                       DateTime                          @default(now())
  updatedAt                       DateTime                          @updatedAt
  leases                          Lease[]
  payments                        Payment[]
  moveInCharges                   MoveInCharge[]
  maintenanceRequests             MaintenanceRequest[]
  messages                        Message[]
  documents                       Document[]
  autopay                         AutoPay?
  eSignatureEnvelopes             ESignatureEnvelope[]
  rentalApplicationHandoffs       RentalApplicationHandoff[]
  MoveInInspection                MoveInInspection[]
  MoveInInspectionAcknowledgement MoveInInspectionAcknowledgement[]
  vacateNotices                   NoticeToVacate[]
  moveOutInspections              MoveOutInspection[]
  depositDispositions             SecurityDepositDisposition[]
  depositLedgerEntries            SecurityDepositLedgerEntry[]
  emailLogs                        EmailLog[]

  @@index([unitId, status])
  @@index([lastMessageAt(sort: Desc), id(sort: Desc)])
}

model Lease {
  id                       String                       @id @default(cuid())
  tenantId                 String
  tenant                   Tenant                       @relation(fields: [tenantId], references: [id])
  unitId                   String
  unit                     Unit                         @relation(fields: [unitId], references: [id])
  startDate                DateTime
  endDate                  DateTime
  monthlyRent              Float
  rentDueDay               Int                          @default(1)
  gracePeriodDays          Int                          @default(5)
  lateFeeAmount            Float                        @default(50)
  securityDeposit          Float
  leasePdfUrl              String?
  status                   String                       @default("active") // pending_signature, signature_action_required, active, expiring, renewed, terminated
  rentalApplicationId      String?                      @unique
  rentalApplication        RentalApplication?           @relation(fields: [rentalApplicationId], references: [id], onDelete: SetNull)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  payments                 Payment[]
  moveInCharges            MoveInCharge[]
  moveInInspection         MoveInInspection?
  eSignatureEnvelopes      ESignatureEnvelope[]
  rentalApplicationHandoff RentalApplicationHandoff?
  renewals                 LeaseRenewal[]
  vacateNotices            NoticeToVacate[]
  moveOutInspections       MoveOutInspection[]
  depositDisposition       SecurityDepositDisposition?
  depositLedgerEntries     SecurityDepositLedgerEntry[]

  @@index([tenantId, status, endDate])
