  id                   String                @id @default(cuid())
  propertyOwnerId      String
  propertyOwner        PropertyOwner         @relation(fields: [propertyOwnerId], references: [id], onDelete: Restrict)
  propertyId           String
  property             Property              @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unitId               String?
  unit                 Unit?                 @relation(fields: [unitId], references: [id], onDelete: Restrict)
  maintenanceRequestId String
  maintenanceRequest   MaintenanceRequest    @relation(fields: [maintenanceRequestId], references: [id], onDelete: Restrict)
  vendorId             String?
  vendor               Vendor?               @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  category             OwnerExpenseCategory  @default(MAINTENANCE)
  entryType            OwnerExpenseEntryType
  amount               Decimal               @db.Decimal(12, 2)
  description          String
  occurredAt           DateTime
  postedByUserId       String?
  postedBy             User?                 @relation("OwnerExpensePostedBy", fields: [postedByUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime              @default(now())

  @@index([propertyOwnerId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([propertyId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([maintenanceRequestId, createdAt, id])
  @@index([unitId])
  @@index([vendorId])
  @@index([postedByUserId])
}

model Message {
  id         String    @id @default(cuid())
  senderId   String
  sender     User      @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])
  subject    String?
  body       String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([receiverId, isRead, createdAt(sort: Desc)])
  @@index([senderId])
}

model Announcement {
  id                      String                        @id @default(cuid())
  audience                AnnouncementAudience          @default(TENANT)
  propertyId              String?
  property                Property?                     @relation(fields: [propertyId], references: [id])
  unitId                  String?
  unit                    Unit?                         @relation(fields: [unitId], references: [id])
  title                   String
  content                 String
  requiresAcknowledgement Boolean                       @default(false)
  createdAt               DateTime                      @default(now())
  acknowledgements        AnnouncementAcknowledgement[]

  @@index([propertyId])
  @@index([unitId])
  @@index([audience, createdAt(sort: Desc), id(sort: Desc)])
}

model Document {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  name             String
  storagePath      String   @map("url")
  type             String // Lease, ID, Income, Notice, etc.
  contentType      String?
  extractionStatus String?
  extractedTerms   Json?
  extractedAt      DateTime?
  uploadedByUserId String?
  uploadedBy       User?    @relation("TenantDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([tenantId])
  @@index([uploadedByUserId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  message   String
  href      String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([userId, isRead, createdAt(sort: Desc), id(sort: Desc)])
}

model AnnouncementAcknowledgement {
  announcementId String
  userId         String
  acknowledgedAt DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId, acknowledgedAt(sort: Desc)])
}

model SaleCommission {
  id                 String                  @id @default(cuid())
  idempotencyKey     String                  @unique @db.Uuid
  requestFingerprint String?                 @db.VarChar(64)
  propertyId         String
  property           Property                @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  agentId            String
  agent              Agent                   @relation(fields: [agentId], references: [id], onDelete: Restrict)
  salePrice          Decimal?                @db.Decimal(14, 2)
  commissionAmount   Decimal                 @db.Decimal(14, 2)
  currency           String                  @default("USD") @db.Char(3)
  receivedAt         DateTime
  paymentMethod      CommissionPaymentMethod
  referenceNumber    String?
  notes              String?
  status             SaleCommissionStatus    @default(ACTIVE)
  recordedByUserId   String
  recordedBy         User                    @relation("SaleCommissionRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  voidedAt           DateTime?
  voidReason         String?
  voidedByUserId     String?
  voidedBy           User?                   @relation("SaleCommissionVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  events             SaleCommissionEvent[]

  @@index([receivedAt(sort: Desc), id(sort: Desc)])
  @@index([status, receivedAt(sort: Desc), id(sort: Desc)])
  @@index([propertyId])
  @@index([agentId, receivedAt(sort: Desc), id(sort: Desc)])
  @@index([recordedByUserId])
  @@index([voidedByUserId])
}

model SaleCommissionEvent {
  id           String                  @id @default(cuid())
  commissionId String
  commission   SaleCommission          @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  type         SaleCommissionEventType
  actorUserId  String
  actor        User                    @relation("SaleCommissionEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  oldValue     Json?
  newValue     Json?
  reason       String?
  createdAt    DateTime                @default(now())

  @@index([commissionId, createdAt, id])
  @@index([actorUserId])
}

model ESignatureEnvelope {
  id                       String                    @id @default(cuid())
  clientRequestId          String                    @unique @db.Uuid
  provider                 ESignatureProvider        @default(VERDOCS)
  providerEnvelopeId       String?                   @unique @db.Uuid
  templateId               String                    @db.Uuid
  documentType             ESignatureDocumentType
  targetType               ESignatureTargetType
  status                   ESignatureEnvelopeStatus  @default(CREATING)
  providerStatus           String?
  title                    String
  tenantId                 String?
  tenant                   Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agentId                  String?
  agent                    Agent?                    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  leaseId                  String?
  lease                    Lease?                    @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  propertyId               String?
  property                 Property?                 @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  recipientRoleName        String
  recipientEmail           String
  recipientFirstName       String
  recipientLastName        String
  recipientStatus          String?
  createdByUserId          String
  createdBy                User                      @relation("ESignatureCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sentAt                   DateTime?
  openedAt                 DateTime?
  completedAt              DateTime?
  declinedAt               DateTime?
  canceledAt               DateTime?
  expiredAt                DateTime?
  expiresAt                DateTime?
  archivedAt               DateTime?
  lastSyncedAt             DateTime?
  failureReason            String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  events                   ESignatureEvent[]
  documents                ESignatureDocument[]
  rentalApplicationHandoff RentalApplicationHandoff?
  leaseRenewal             LeaseRenewal?

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([agentId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([leaseId])
  @@index([propertyId])
  @@index([createdByUserId])
}

model ESignatureEvent {
  id              String                @id @default(cuid())
  envelopeId      String
  envelope        ESignatureEnvelope    @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  providerEventId String                @unique
  source          ESignatureEventSource
  eventType       String
  actor           String?
  payload         Json?
  occurredAt      DateTime
  createdAt       DateTime              @default(now())

  @@index([envelopeId, occurredAt, id])
}

model ESignatureDocument {
  id                 String                       @id @default(cuid())
  envelopeId         String
  envelope           ESignatureEnvelope           @relation(fields: [envelopeId], references: [id], onDelete: Restrict)
  providerDocumentId String                       @db.Uuid
  documentType       ESignatureStoredDocumentType
  name               String
  mime               String
  size               Int
  storagePath        String                       @unique
  sha256             String                       @db.Char(64)
  providerCreatedAt  DateTime?
  archivedAt         DateTime                     @default(now())
  createdAt          DateTime                     @default(now())

  @@unique([envelopeId, providerDocumentId])
  @@index([envelopeId, archivedAt, id])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([resource, createdAt(sort: Desc), id(sort: Desc)])
  @@index([action, createdAt(sort: Desc), id(sort: Desc)])
}

model EmailLog {
  id                     String       @id @default(cuid())
  to                     String
  tenantId               String?
  tenant                 Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  propertyId             String?
  property               Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unitId                 String?
  unit                   Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  sentByUserId           String?
  sentBy                 User?        @relation("EmailLogSender", fields: [sentByUserId], references: [id], onDelete: SetNull)
  batchId                String?
  batch                  EmailBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  subject                String
  body                   String?
  templateKey            String
  templateVersion        Int          @default(1)
  status                 String       @default("PENDING")
  critical               Boolean      @default(false)
  idempotencyKey         String       @unique
  providerIdempotencyKey String
  resendEmailId          String?      @unique
  attemptCount           Int          @default(0)
  maxAttempts            Int          @default(1)
  nextRetryAt            DateTime?
  lastAttemptAt          DateTime?
  lastError              String?
  sentAt                 DateTime?
  deliveredAt            DateTime?
  openedAt               DateTime?
  clickedAt              DateTime?
  bouncedAt              DateTime?
  complainedAt           DateTime?
  failedAt               DateTime?
  suppressedAt           DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  events                 EmailEvent[]

  @@index([status, nextRetryAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([batchId, createdAt(sort: Desc), id(sort: Desc)])
}

model EmailBatch {
  id              String    @id @default(cuid())
  createdByUserId String
  createdBy       User      @relation("EmailBatchCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  templateKey     String
  subject         String
  audienceType    String
  propertyId      String?
  property        Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  recipientCount  Int
  status          String    @default("CREATED")
  idempotencyKey  String    @unique @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  emailLogs       EmailLog[]

  @@index([createdByUserId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([propertyId, createdAt(sort: Desc), id(sort: Desc)])
}

model EmailEvent {
  id                String   @id @default(cuid())
  emailLogId        String
  emailLog          EmailLog @relation(fields: [emailLogId], references: [id], onDelete: Cascade)
  providerEventId   String   @unique
  type              String
  providerCreatedAt DateTime
  payload           Json?
  createdAt         DateTime @default(now())

  @@index([emailLogId, providerCreatedAt])
}
