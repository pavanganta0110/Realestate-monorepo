enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
  WAIVED
  REFUNDED
}

enum StripeCheckoutStatus {
  NOT_STARTED
  OPEN
  COMPLETE
  FAILED
  EXPIRED
}

enum StripeWebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model Payment {
  id                         String         @id @default(cuid())
  tenantId                   String
  tenant                     Tenant         @relation(fields: [tenantId], references: [id])
  leaseId                    String
  lease                      Lease          @relation(fields: [leaseId], references: [id])
  unitId                     String
  unit                       Unit           @relation(fields: [unitId], references: [id])
  propertyOwnerId            String?
  propertyOwner              PropertyOwner? @relation(fields: [propertyOwnerId], references: [id], onDelete: Restrict)
  rentAmount                 Float
  lateFee                    Float          @default(0)
  totalAmount                Float
  paidAmount                 Float          @default(0)
  refundedAmount             Float          @default(0)
  balanceDue                 Float
  purpose                    PaymentPurpose @default(RENT)
  paymentMethod              String? // cash, check, Zelle, bank transfer, other
  referenceNumber            String?        @unique
  idempotencyKey             String         @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordRequestFingerprint   String?        @db.VarChar(64)
  lastStatusRequestId        String?        @unique @db.Uuid
  status                     PaymentStatus  @default(PENDING)
  paidAt                     DateTime?
  ownerCommissionRate        Decimal?       @db.Decimal(5, 2)
  managementCommissionAmount Decimal?       @db.Decimal(12, 2)
  ownerProceedsAmount        Decimal?       @db.Decimal(12, 2)
  // The first day of the month this charge covers. Manual legacy records can
  // remain null; automatically generated monthly rent charges are unique per
  // lease and billing period.
  billingPeriod              DateTime?      @db.Date
  dueDate                    DateTime
  receiptUrl                 String?
  notes                      String?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  // Tenant-initiated, one-time Checkout records. No subscription or off-session
  // collection is permitted for rental payments.
  stripeCustomerId         String?
  stripeCheckoutSessionId  String?              @unique
  stripeCheckoutUrl        String?              @db.Text
  stripeCheckoutStatus     StripeCheckoutStatus @default(NOT_STARTED)
  stripeCheckoutExpiresAt  DateTime?
  stripePaymentIntentId    String?              @unique
  stripeChargeId           String?              @unique
  stripeTransferId         String?
  stripeTransferReversalId String?              @unique
  stripePaymentMethodType  String?
  stripeLastEventAt        DateTime?
  stripeWebhookEvents      StripeWebhookEvent[]
  allocations              PaymentAllocation[]

  @@index([propertyOwnerId, paidAt(sort: Desc), id(sort: Desc)])
  @@index([status, paidAt(sort: Desc), id(sort: Desc)])
  @@index([stripeCheckoutStatus, stripeCheckoutExpiresAt])
  @@index([tenantId])
  @@index([leaseId])
  @@index([unitId])
  @@index([status, dueDate])
  @@index([leaseId, billingPeriod])
  @@index([purpose, paidAt(sort: Desc), id(sort: Desc)])
}

