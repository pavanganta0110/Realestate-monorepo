# Supabase transaction pooler connection string for Vercel runtime traffic.
# Copy the Prisma DATABASE_URL from the Supabase Connect dialog.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require&connection_limit=1&pool_timeout=30"

# Supabase Auth. The secret key is server-only; never expose it to the browser.
SUPABASE_URL="https://xwrlpqakdndpnqqpfepz.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_Ifckzn2bSFAxGE-UYgVnJw_WOC2lRIf"
SUPABASE_SECRET_KEY="sb_secret_replace_with_project_secret_key"
BACKEND_PORT=3001
FRONTEND_URL="http://localhost:3000"

# Production portal origins. FRONTEND_URL remains the local-development and
# backward-compatible fallback.
PUBLIC_SITE_URL="https://coachjohnsonrealty.com"
AGENT_PORTAL_URL="https://agents.coachjohnsonrealty.com"
PROPERTIES_ADMIN_URL="https://properties-admin.coachjohnsonrealty.com"
RENTAL_ADMIN_URL="https://rental-admin.coachjohnsonrealty.com"
TENANT_PORTAL_URL="https://tenant.coachjohnsonrealty.com"
SUPER_ADMIN_URL="https://admin.coachjohnsonrealty.com"
CORS_ORIGINS="https://coachjohnsonrealty.com,https://agents.coachjohnsonrealty.com,https://properties-admin.coachjohnsonrealty.com,https://rental-admin.coachjohnsonrealty.com,https://tenant.coachjohnsonrealty.com,https://admin.coachjohnsonrealty.com"

# Transactional email (Resend). RESEND_FROM_EMAIL must use a verified domain in production.
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM_EMAIL="Coach Johnson Realty <noreply@coachjohnsonrealty.com>"
RESEND_WEBHOOK_SECRET="whsec_your_resend_webhook_signing_secret"
# Random 32+ character secret used by Vercel Cron to authorize retry dispatch.
CRON_SECRET="replace_with_a_random_secret"

# E-signatures (Verdocs Free: 25 envelopes/month). Create these credentials in
# Verdocs Settings > API Keys, then register /webhooks/verdocs as the webhook URL.
ESIGNATURES_ENABLED=false
VERDOCS_API_BASE_URL="https://api.verdocs.com"
VERDOCS_CLIENT_ID=""
VERDOCS_CLIENT_SECRET=""
VERDOCS_WEBHOOK_SECRET=""
VERDOCS_LEASE_TEMPLATE_ID=""
VERDOCS_DISCLOSURE_TEMPLATE_ID=""
VERDOCS_AGREEMENT_TEMPLATE_ID=""
VERDOCS_SENDER_NAME="Coach Johnson Realty"
VERDOCS_SENDER_EMAIL="noreply@coachjohnsonrealty.com"

# Public website AI assistant. Groq GPT-OSS 20B writes replies; Prompt Guard
# 86M screens every visitor message for prompt attacks. Keep values server-only.
CHATBOT_ENABLED=false
GROQ_API_KEY="gsk_replace_with_groq_key"
GEMINI_API_KEY="AIza_replace_with_gemini_key"
# Generate with: openssl rand -hex 32
CHATBOT_FINGERPRINT_SECRET="replace-with-at-least-32-random-characters"

# Tenant-initiated rental payments only. Keep this false until the database
# migration is applied and the sensitive Vercel variables are configured.
STRIPE_RENT_PAYMENTS_ENABLED=false
STRIPE_APPLICATION_FEES_ENABLED=false
RENTAL_APPLICATION_ALERT_EMAIL=
STRIPE_SECRET_KEY="rk_live_replace_with_restricted_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_stripe_webhook_signing_secret"
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_replace_with_stripe_connect_webhook_signing_secret"

# Optional verification-script targets. Use a bounded Supabase pooler URL for
# the launch-readiness load check and an explicit local/staging API origin for
# workflow scripts so they never target production by accident.
VERIFY_API_URL="http://127.0.0.1:3016/api"
VERIFY_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require&connection_limit=3&pool_timeout=30"
